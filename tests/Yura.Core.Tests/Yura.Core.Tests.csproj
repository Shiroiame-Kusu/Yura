<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Yura.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform, which is the only supported
         'dotnet test' path on the .NET 10 SDK. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Yura.Core/Yura.Core.csproj" />
    <!-- The configuration layer lives in the app because the app owns ~/.config/Yura; the
         daemon runs as root and must not write there. -->
    <ProjectReference Include="../../src/Yura.App/Yura.App.csproj" />
  </ItemGroup>

</Project>
