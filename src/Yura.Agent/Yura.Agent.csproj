<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Yura.Agent</RootNamespace>
    <AssemblyName>yura-agent</AssemblyName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- Nothing here is localised: the agent's only output is an operator's log. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published as NativeAOT: one native file, no .NET needed on the server, and nothing
         compiled at run time. Building is unaffected, so the test project can still reference
         this one. See tools/publish-agent.sh. -->
    <PublishAot>true</PublishAot>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Yura.Core/Yura.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yura.Agent.Tests" />
  </ItemGroup>

</Project>
