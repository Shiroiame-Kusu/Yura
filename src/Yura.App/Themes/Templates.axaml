<!--
  Shared converters and cell templates.

  Kept out of Tokens.axaml so that file stays purely declarative design values.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Yura.App.Converters"
                    xmlns:vm="using:Yura.App.ViewModels">

  <conv:EnumToBoolConverter x:Key="EnumToBool" />
  <conv:ProtocolDisplayConverter x:Key="ProtocolDisplay" />

  <!-- The routing-policy cell. Pairs a colour with a word so colour never carries the
       meaning on its own, and stays fixed width so the column does not jitter. -->
  <DataTemplate x:Key="PolicyCell" x:DataType="vm:ProcessRowViewModel">
    <Border Classes="Badge"
            Classes.Accent="{Binding IsProxiedPolicy}"
            Classes.Danger="{Binding IsBlockedPolicy}"
            Classes.Warning="{Binding IsPendingPolicy}"
            HorizontalAlignment="Left">
      <TextBlock Text="{Binding PolicyDisplay}" TextTrimming="CharacterEllipsis" MaxWidth="126" />
    </Border>
  </DataTemplate>

</ResourceDictionary>
