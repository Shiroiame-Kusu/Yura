<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Yura.App.ViewModels"
             xmlns:loc="using:Yura.App.Localization"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:views="using:Yura.App.Views"
             mc:Ignorable="d"
             x:Class="Yura.App.Views.ProcessesPage"
             x:DataType="vm:ProcessesPageViewModel">

  <!-- Column widths are repeated verbatim on the header grid and the row grid. Avalonia has
       no shared-size scope, so keeping the two literals identical is what holds the columns
       aligned; change one and you must change the other. -->

  <Grid RowDefinitions="Auto,*">

    <!-- ============================ Page header ============================ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,12">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Classes="PageTitle" Text="{loc:Tr Processes.Title}" />
        <TextBlock Classes="Subtitle" Text="{loc:Tr Processes.Subtitle}" MaxWidth="560"
                   HorizontalAlignment="Left" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <TextBox Width="260"
                 Text="{Binding SearchText}"
                 PlaceholderText="{loc:Tr Processes.SearchPlaceholder}"
                 AutomationProperties.Name="{loc:Tr Processes.SearchPlaceholder}" />

        <ToggleButton IsChecked="{Binding IsPaused}"
                      Content="{loc:Tr Common.Pause}"
                      AutomationProperties.Name="{loc:Tr Common.Pause}" />

        <Button Command="{Binding RefreshCommand}"
                Content="{loc:Tr Common.Refresh}"
                AutomationProperties.Name="{loc:Tr Common.Refresh}" />
      </StackPanel>
    </Grid>

    <!-- ======================= Table + inspector ======================= -->
    <Panel Grid.Row="1">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,0,20,16">

      <Border Grid.Column="0" Classes="Panel" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Column header -->
          <Border Grid.Row="0" Classes="ColumnHeader">
            <Grid Margin="12,0" ColumnDefinitions="150,72,60,*,72,96,44">
              <TextBlock Grid.Column="0" Text="{loc:Tr Processes.Column.Process}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Processes.Column.Pid}" HorizontalAlignment="Right" Margin="0,0,8,0" />
              <TextBlock Grid.Column="2" Text="{loc:Tr Processes.Column.User}" />
              <TextBlock Grid.Column="3" Text="{loc:Tr Processes.Column.Path}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="4" Text="{loc:Tr Processes.Column.Parent}" HorizontalAlignment="Right" Margin="0,0,8,0" />
              <TextBlock Grid.Column="5" Text="{loc:Tr Processes.Column.Policy}" />
              <TextBlock Grid.Column="6" Text="{loc:Tr Processes.Column.Connections}" HorizontalAlignment="Right" />
            </Grid>
          </Border>

          <!-- Rows. Virtualized by ListBox's default VirtualizingStackPanel. -->
          <ListBox Grid.Row="1"
                   Classes="Table"
                   ItemsSource="{Binding Processes}"
                   SelectedItem="{Binding SelectedProcess}"
                   SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.AllowAutoHide="True"
                   AutomationProperties.Name="{loc:Tr Processes.Title}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProcessRowViewModel">
                <Grid Margin="12,0" ColumnDefinitions="150,72,60,*,72,96,44" Height="34">

                  <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,8,0">
                    <icons:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="16"
                                      Foreground="{DynamicResource YuraTextTertiary}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding DisplayName}" />
                    <Border Grid.Column="2" Classes="Badge Accent" IsVisible="{Binding IsWine}" Margin="6,0,0,0">
                      <TextBlock Text="Wine" />
                    </Border>
                  </Grid>

                  <TextBlock Grid.Column="1" Classes="Numeric" Text="{Binding Pid}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />

                  <TextBlock Grid.Column="2" Classes="Secondary" Text="{Binding UserName}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                  <!-- Long paths trim from the head so the file name stays visible; the
                       full value is in the inspector and the tooltip. -->
                  <TextBlock Grid.Column="3" Classes="Mono Secondary"
                             Classes.Unavailable="{Binding PathIsUnavailable}"
                             Text="{Binding PathDisplay}"
                             VerticalAlignment="Center"
                             TextTrimming="LeadingCharacterEllipsis"
                             Margin="0,0,12,0"
                             ToolTip.Tip="{Binding PathDisplay}" />

                  <TextBlock Grid.Column="4" Classes="Numeric Secondary" Text="{Binding ParentPid}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />

                  <ContentControl Grid.Column="5" Content="{Binding}" VerticalAlignment="Center"
                                  ContentTemplate="{StaticResource PolicyCell}" />

                  <TextBlock Grid.Column="6" Classes="Numeric Secondary"
                             Text="{Binding ConnectionCountDisplay}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty state -->
          <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="320">
            <TextBlock Text="{loc:Tr Processes.Empty}" HorizontalAlignment="Center" />
            <TextBlock Classes="Caption" Text="{loc:Tr Processes.EmptyHint}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Status strip -->
          <Border Grid.Row="2" Background="{DynamicResource YuraSurfaceRaised}"
                  BorderBrush="{DynamicResource YuraBorderSubtle}" BorderThickness="0,1,0,0"
                  Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Classes="Caption Metric"
                         Text="{Binding CountSummary}" />
              <Border Grid.Column="1" Classes="Badge Warning" HorizontalAlignment="Left" Margin="12,0,0,0"
                      IsVisible="{Binding IsPaused}">
                <TextBlock Text="{loc:Tr Common.Paused}" />
              </Border>
              <CheckBox Grid.Column="2" IsChecked="{Binding LiveSorting}" Content="{loc:Tr Processes.LiveSorting}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Width="1" Background="{DynamicResource YuraBorderSubtle}" Margin="12,0"
              IsVisible="{Binding !IsCompact}" />

      <!-- Docked inspector, wide windows only. -->
      <views:ProcessInspector Grid.Column="2" Width="288" IsVisible="{Binding !IsCompact}" />
    </Grid>

    <!-- Narrow windows: the inspector floats over the table instead of competing with it
         for width. Below roughly 1120 DIPs a docked panel squeezes the executable path
         column out of existence, which costs more than the overlay does. -->
    <views:ProcessInspector Width="320"
                            HorizontalAlignment="Right"
                            Margin="0,0,20,16"
                            Classes="Floating"
                            IsVisible="{Binding ShowOverlayInspector}" />
    </Panel>
  </Grid>
</UserControl>
