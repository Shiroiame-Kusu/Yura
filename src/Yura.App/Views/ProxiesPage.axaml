<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Yura.App.ViewModels"
             xmlns:loc="using:Yura.App.Localization"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:views="using:Yura.App.Views"
             xmlns:proxies="using:Yura.Core.Proxies"
             mc:Ignorable="d"
             x:Class="Yura.App.Views.ProxiesPage"
             x:DataType="vm:ProxiesPageViewModel">

  <Grid RowDefinitions="Auto,*">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,12">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Classes="PageTitle" Text="{loc:Tr Nav.Proxies}" />
        <TextBlock Classes="Subtitle" Text="{loc:Tr Proxy.Hint}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Command="{Binding AddChainCommand}" IsEnabled="{Binding CanAddChain}"
                Content="{loc:Tr Chain.Add}" />
        <Button Command="{Binding AddWireGuardCommand}" Content="{loc:Tr Proxy.AddWireGuard}" />
        <Button Command="{Binding AddAgentCommand}" Content="{loc:Tr Proxy.AddAgent}" />
        <Button Classes="accent" Command="{Binding AddProxyCommand}" Content="{loc:Tr Proxy.Editor.TitleNew}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,16,Auto" Margin="24,0,24,20">

      <!-- ============================ Lists ============================ -->
      <Border Grid.Column="0" Classes="Panel" ClipToBounds="True">
        <ScrollViewer>
          <StackPanel>

            <!-- Proxies and exits. Selecting a row opens it in the editor. -->
            <Border Classes="ColumnHeader" Padding="12,0">
              <TextBlock Text="{loc:Tr Proxy.Section}" />
            </Border>
            <ListBox Classes="Table" ItemsSource="{Binding Proxies}"
                     SelectedItem="{Binding SelectedProxy}"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="{loc:Tr Proxy.Section}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProxyRowViewModel">
                  <Grid Margin="12,8" ColumnDefinitions="*,Auto">
                    <Border Grid.ColumnSpan="2" Classes="Divider" VerticalAlignment="Bottom"
                            Margin="0,0,0,-8" />
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="Mono Tertiary" Text="{Binding Authority}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authority}" />
                      <!-- For an exit Yura runs both ends of, what it is actually doing:
                           the kernel's own account of a tunnel, or the agent's session. -->
                      <TextBlock Classes="Caption" Text="{Binding StateText}" TextWrapping="Wrap"
                                 IsVisible="{Binding ShowState}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="Badge" VerticalAlignment="Top" Margin="8,2,0,0"
                            Classes.Success="{Binding IsExitUp}"
                            Classes.Danger="{Binding IsExitDown}">
                      <TextBlock Text="{Binding ProtocolDisplay}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding !HasProxies}" Margin="12,28" Spacing="6" MaxWidth="360"
                        HorizontalAlignment="Center">
              <TextBlock Text="{loc:Tr Proxy.Empty}" HorizontalAlignment="Center" />
              <TextBlock Classes="Caption" TextAlignment="Center" TextWrapping="Wrap" Text="{loc:Tr Proxy.EmptyHint}" />
            </StackPanel>

            <!-- Chains: dialled in order, first hop first. -->
            <Border Classes="ColumnHeader" Padding="12,0" Margin="0,8,0,0">
              <TextBlock Text="{loc:Tr Chain.Section}" />
            </Border>
            <ListBox Classes="Table" ItemsSource="{Binding Chains}"
                     SelectedItem="{Binding SelectedChain}"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="{loc:Tr Chain.Section}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChainRowViewModel">
                  <Grid Margin="12,8" ColumnDefinitions="*,Auto">
                    <Border Grid.ColumnSpan="2" Classes="Divider" VerticalAlignment="Bottom"
                            Margin="0,0,0,-8" />
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="Mono Tertiary" Text="{Binding HopsDisplay}" TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding HopsDisplay}" />
                      <TextBlock Classes="FieldError" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="Badge" VerticalAlignment="Top" Margin="8,2,0,0"
                            Classes.Danger="{Binding HasProblem}">
                      <TextBlock Text="{Binding HopCount}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="Caption" Text="{loc:Tr Chain.Empty}" TextWrapping="Wrap" Margin="12,14,12,20"
                       IsVisible="{Binding !HasChains}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- The editors, docked. Below the threshold they float instead; see the code-behind. -->
      <views:ProxyInspector Grid.Column="2" Width="440" IsVisible="{Binding !IsCompact}" />
    </Grid>

    <!-- Floating placement. Same control, so the two cannot drift. -->
    <views:ProxyInspector Grid.Row="1" Width="440"
                          HorizontalAlignment="Right" Margin="0,0,24,20"
                          Classes="Floating"
                          IsVisible="{Binding IsCompact}" />
  </Grid>
</UserControl>
