<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Yura.App.ViewModels"
             xmlns:loc="using:Yura.App.Localization"
             mc:Ignorable="d"
             x:Class="Yura.App.Views.ProcessInspector"
             x:DataType="vm:ProcessesPageViewModel">

  <!--
    The contextual inspector for the selected process: identity, rule scope, route and
    actions in one place.

    It lives in its own control because the page shows it in two different positions - docked
    beside the table on a wide window, and as an overlay on a narrow one - and duplicating
    the markup would guarantee the two drift apart.
  -->
  <Border Classes="Panel">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">

            <!-- Nothing selected -->
            <TextBlock Classes="Subtitle" Text="{loc:Tr Processes.Inspector.NoSelection}"
                       IsVisible="{Binding !HasSelection}" />

            <StackPanel Spacing="16" IsVisible="{Binding HasSelection}">

              <!-- Identity -->
              <StackPanel Spacing="6">
                <TextBlock Classes="SectionTitle" Text="{Binding SelectedProcess.DisplayName}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="Mono Tertiary" Text="{Binding SelectedProcess.PathDisplay}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="Badge">
                    <TextBlock Text="{Binding SelectedProcess.Pid, StringFormat='PID {0}'}" />
                  </Border>
                  <Border Classes="Badge">
                    <TextBlock Text="{Binding SelectedProcess.UserName}" />
                  </Border>
                  <Border Classes="Badge Warning" IsVisible="{Binding SelectedProcess.ExecutableWasReplaced}">
                    <TextBlock Text="{loc:Tr Processes.PathDeleted}" />
                  </Border>
                </StackPanel>
              </StackPanel>

              <Border Classes="Divider" />

              <!-- Rule scope: the three scopes, each with the consequence spelled out.

                   No GroupName: Avalonia groups a radio button with its siblings when none is
                   set, and this control is instantiated twice in the same window (docked and
                   floating). A shared group name makes the two copies fight over one group,
                   which leaves the hidden copy with nothing selected. -->
              <StackPanel Spacing="8">
                <TextBlock Classes="FieldLabel" Text="{loc:Tr Processes.Scope.Title}" />

                <RadioButton IsChecked="{Binding ScopeChoice,
                               Converter={StaticResource EnumToBool}, ConverterParameter=Instance}">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{loc:Tr Processes.Scope.Instance}" TextWrapping="Wrap" />
                    <TextBlock Classes="Caption" Text="{loc:Tr Processes.Scope.InstanceHint}" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>

                <RadioButton IsChecked="{Binding ScopeChoice,
                               Converter={StaticResource EnumToBool}, ConverterParameter=Executable}">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{loc:Tr Processes.Scope.Executable}" TextWrapping="Wrap" />
                    <TextBlock Classes="Caption" Text="{loc:Tr Processes.Scope.ExecutableHint}" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>

                <RadioButton IsChecked="{Binding ScopeChoice,
                               Converter={StaticResource EnumToBool}, ConverterParameter=Tree}">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{loc:Tr Processes.Scope.Tree}" TextWrapping="Wrap" />
                    <TextBlock Classes="Caption" Text="{loc:Tr Processes.Scope.TreeHint}" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>

                <!-- Children belong with the scope, not with the actions: it is the same
                     question. The tree scope already answers it, so the box is only offered
                     for the two scopes where the user still has a choice. -->
                <StackPanel Spacing="2" IsVisible="{Binding ChildrenChoiceApplies}">
                  <CheckBox IsChecked="{Binding IncludeChildren}">
                    <TextBlock Text="{loc:Tr Processes.Action.IncludeChildren}" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock Classes="FieldHint" Text="{loc:Tr Processes.Scope.ExcludeHint}"
                             IsVisible="{Binding !IncludeChildren}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <!-- Route -->
              <StackPanel Spacing="2">
                <TextBlock Classes="FieldLabel" Text="{loc:Tr Processes.Inspector.Route}" />
                <ComboBox ItemsSource="{Binding AvailableProxies}"
                          SelectedItem="{Binding SelectedProxy}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="{loc:Tr Games.SelectRoute}"
                          AutomationProperties.Name="{loc:Tr Processes.Inspector.Route}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Actions.

                   One button per row, and every label allowed to wrap. The panel is 288 DIPs
                   wide docked, so a two-up grid leaves about 120 for a label: "Inspect
                   connections" and "Block network access" were being cut off mid-word, with
                   no ellipsis to show that anything was missing. Pairing them saved a little
                   height and cost the user the labels. -->
              <StackPanel Spacing="8">
                <TextBlock Classes="FieldLabel" Text="{loc:Tr Processes.Inspector.Actions}" />

                <!-- Whether the rule reaches what is already connected. Next to the buttons
                     that install it, because it changes what pressing them does. -->
                <StackPanel Spacing="2">
                  <CheckBox IsChecked="{Binding ResetExistingConnections}">
                    <TextBlock Text="{loc:Tr Processes.Action.ResetExisting}" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock Classes="FieldHint" TextWrapping="Wrap"
                             Text="{loc:Tr Processes.Action.ResetExistingHint}"
                             IsVisible="{Binding ResetExistingConnections}" />
                  <TextBlock Classes="FieldHint" TextWrapping="Wrap"
                             Text="{loc:Tr Processes.Action.ResetExistingOffHint}"
                             IsVisible="{Binding !ResetExistingConnections}" />
                </StackPanel>

                <!-- Says what the chosen scope will install: it always said "this instance",
                     whichever scope was picked above it. -->
                <Button Classes="accent" HorizontalAlignment="Stretch"
                        Command="{Binding ProxyThisInstanceCommand}">
                  <TextBlock Text="{Binding ProxyButtonLabel}" TextWrapping="Wrap"
                             TextAlignment="Center" />
                </Button>

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding AlwaysProxyExecutableCommand}">
                  <TextBlock Text="{loc:Tr Processes.Action.AlwaysProxy}" TextWrapping="Wrap"
                             TextAlignment="Center" />
                </Button>

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding RouteDirectCommand}">
                  <TextBlock Text="{loc:Tr Processes.Action.Direct}" TextWrapping="Wrap"
                             TextAlignment="Center" />
                </Button>

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding BlockCommand}">
                  <TextBlock Text="{loc:Tr Processes.Action.Block}" TextWrapping="Wrap"
                             TextAlignment="Center" />
                </Button>

                <!-- Why an action is unavailable, beside the control rather than in a tooltip. -->
                <TextBlock Classes="FieldHint" Text="{Binding ApplyBlockedReason}" TextWrapping="Wrap"
                           IsVisible="{Binding ApplyBlockedReason, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Result of the last apply, where the user is looking when they press the
                     button. It used to be below the covering-rules list, off the bottom of a
                     panel this narrow. -->
                <Border Classes="Panel" Padding="12" Background="{DynamicResource YuraAccentSubtle}"
                        BorderBrush="{DynamicResource YuraAccent}"
                        IsVisible="{Binding LastApplied, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding LastApplied.Headline}" TextWrapping="Wrap" />
                    <TextBlock Classes="Caption" Text="{Binding LastApplied.Body}" TextWrapping="Wrap" />
                    <TextBlock Classes="Caption" Text="{Binding LastApplied.Caveat}" TextWrapping="Wrap"
                               Foreground="{DynamicResource YuraWarning}"
                               IsVisible="{Binding LastApplied.Caveat, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Border>

                <!-- Failure: what failed, plus expandable technical detail. -->
                <Border Classes="Panel" Padding="12" Background="{DynamicResource YuraDangerSubtle}"
                        BorderBrush="{DynamicResource YuraDanger}"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <Expander Header="{loc:Tr Common.Details}"
                              IsVisible="{Binding ErrorDiagnostics, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <SelectableTextBlock Classes="Mono" Text="{Binding ErrorDiagnostics}" TextWrapping="Wrap" />
                    </Expander>
                  </StackPanel>
                </Border>

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding RemoveOverrideCommand}"
                        Content="{loc:Tr Processes.Action.RemoveOverride}" />

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding InspectConnectionsCommand}">
                  <TextBlock Text="{loc:Tr Processes.Action.InspectConnections}" TextWrapping="Wrap"
                             TextAlignment="Center" />
                </Button>

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding AddAsGameCommand}"
                        Content="{loc:Tr Processes.Action.AddAsGame}" />
              </StackPanel>

              <!-- Every rule that covers this process, in evaluation order, so precedence is
                   visible where the decision is made rather than only on the Rules page. -->
              <StackPanel Spacing="6" IsVisible="{Binding HasCoveringRules}">
                <Border Classes="Divider" />
                <TextBlock Classes="FieldLabel" Text="{loc:Tr Processes.RulesCovering}" />
                <ItemsControl ItemsSource="{Binding CoveringRules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoveringRule">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2" ColumnSpacing="8">
                        <Border Grid.Column="0" Classes="Badge" Classes.Accent="{Binding IsWinner}">
                          <TextBlock Text="{Binding Position}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="0">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="Caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

            </StackPanel>
          </StackPanel>
        </ScrollViewer>
  </Border>
</UserControl>
